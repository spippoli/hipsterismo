+////////////////////////////////////////////////////////////////////////
+// InCircle() :
+//   Return true if a point (xp,yp) is inside or on the circumcircle of the
+//   triangle (x1,y1), (x2,y2), (x3,y3), from the sign of the in-circle
+//   determinant. Unlike CircumCircle()'s rounded centre and radius, it
+//   gives the same answer for every triangle on one circle: it is exact
+//   when the coordinates are multiples of 0.5 below about 2600. A
+//   degenerate triangle has no circumcircle, as in CircumCircle().
+////////////////////////////////////////////////////////////////////////
+
+static bool InCircle(double xp, double yp, double x1, double y1, double x2,
+double y2, double x3, double y3){
+    double orient = (x2 - x1) * (y3 - y1) - (y2 - y1) * (x3 - x1);
+    if(orient == 0)
+        return false;
+    double adx = x1 - xp, ady = y1 - yp;
+    double bdx = x2 - xp, bdy = y2 - yp;
+    double cdx = x3 - xp, cdy = y3 - yp;
+    double alift = adx * adx + ady * ady;
+    double blift = bdx * bdx + bdy * bdy;
+    double clift = cdx * cdx + cdy * cdy;
+    double det = adx * (bdy * clift - cdy * blift)
+               - ady * (bdx * clift - cdx * blift)
+               + alift * (bdx * cdy - cdx * bdy);
+    return (orient > 0) ? det >= 0 : det <= 0;
+}
+
+////////////////////////////////////////////////////////////////////////
+// SymbolicInCircle() :
+//   The in-circle test for a triangle with supertriangle vertices, which
+//   are treated as points at infinity. Supertriangle vertex k is
+//   superC[k] + R * superD[k] for R -> infinity (upstream's shape, with
+//   R = 20 * dmax). Each coordinate is a polynomial in R, so the
+//   orientation and the in-circle determinant are too, and their signs as
+//   R -> infinity are the signs of their leading nonzero coefficients.
+//   This is the exact answer for every large enough R, so the
+//   triangulation is that of the points plus a real supertriangle: no
+//   rounded decision near the hull can make the cavity not star-shaped,
+//   and no triangle of real points is lost because its circumcircle
+//   reaches a supertriangle vertex. The coefficients are sums of
+//   products of coordinate differences, like InCircle()'s determinant.
+////////////////////////////////////////////////////////////////////////
+
+namespace {
+
+// a polynomial in R, c[k] being the coefficient of R^k
+struct Poly {
+    double c[5];
+};
+
+Poly poly(double c0, double c1){
+    Poly p = {{c0, c1, 0, 0, 0}};
+    return p;
+}
+
+Poly operator+(const Poly &a, const Poly &b){
+    Poly p;
+    for(int k = 0; k < 5; k++) p.c[k] = a.c[k] + b.c[k];
+    return p;
+}
+
+Poly operator-(const Poly &a, const Poly &b){
+    Poly p;
+    for(int k = 0; k < 5; k++) p.c[k] = a.c[k] - b.c[k];
+    return p;
+}
+
+// The degrees used here never exceed 4.
+Poly operator*(const Poly &a, const Poly &b){
+    Poly p = {{0, 0, 0, 0, 0}};
+    for(int i = 0; i < 5; i++)
+        for(int j = 0; i + j < 5; j++)
+            p.c[i + j] += a.c[i] * b.c[j];
+    return p;
+}
+
+int signAtInfinity(const Poly &p){
+    for(int k = 4; k >= 0; k--){
+        if(p.c[k] > 0) return 1;
+        if(p.c[k] < 0) return -1;
+    }
+    return 0;
+}
+
+}
+
+static bool SymbolicInCircle(double xp, double yp, const int idx[3], int nv,
+const XYZ pxyz[], const double superC[3][2], const int superD[3][2]){
+    Poly x[3], y[3];
+    for(int k = 0; k < 3; k++){
+        if(idx[k] < nv){
+            x[k] = poly(pxyz[idx[k]].x - xp, 0);
+            y[k] = poly(pxyz[idx[k]].y - yp, 0);
+        }else{
+            int s = idx[k] - nv;
+            x[k] = poly(superC[s][0] - xp, superD[s][0]);
+            y[k] = poly(superC[s][1] - yp, superD[s][1]);
+        }
+    }
+    int orient = signAtInfinity((x[1] - x[0]) * (y[2] - y[0]) - (y[1] - y[0]) * (x[2] - x[0]));
+    if(orient == 0)
+        return false;
+    Poly lift[3];
+    for(int k = 0; k < 3; k++) lift[k] = x[k] * x[k] + y[k] * y[k];
+    int det = signAtInfinity(x[0] * (y[1] * lift[2] - y[2] * lift[1])
+                           - y[0] * (x[1] * lift[2] - x[2] * lift[1])
+                           + lift[0] * (x[1] * y[2] - x[2] * y[1]));
+    return (orient > 0) ? det >= 0 : det <= 0;
+}
+
