+////////////////////////////////////////////////////////////////////////
+// InCircle() :
+//   Return true if a point (xp,yp) is inside or on the circumcircle of the
+//   triangle (x1,y1), (x2,y2), (x3,y3), from the sign of the in-circle
+//   determinant. Unlike CircumCircle()'s rounded centre and radius, it
+//   gives the same answer for every triangle on one circle: it is exact
+//   when the coordinates are multiples of 0.5 below about 2600. A
+//   degenerate triangle has no circumcircle, as in CircumCircle().
+////////////////////////////////////////////////////////////////////////
+
+static bool InCircle(double xp, double yp, double x1, double y1, double x2,
+double y2, double x3, double y3){
+    double orient = (x2 - x1) * (y3 - y1) - (y2 - y1) * (x3 - x1);
+    if(orient == 0)
+        return false;
+    double adx = x1 - xp, ady = y1 - yp;
+    double bdx = x2 - xp, bdy = y2 - yp;
+    double cdx = x3 - xp, cdy = y3 - yp;
+    double alift = adx * adx + ady * ady;
+    double blift = bdx * bdx + bdy * bdy;
+    double clift = cdx * cdx + cdy * cdy;
+    double det = adx * (bdy * clift - cdy * blift)
+               - ady * (bdx * clift - cdx * blift)
+               + alift * (bdx * cdy - cdx * bdy);
+    return (orient > 0) ? det >= 0 : det <= 0;
+}
